# ==============================================
# Environment Variables Template
# Copy this file to .env and fill in the values
# ==============================================

# --- General ---
COMPOSE_PROJECT_NAME=microservices-assignment
ENVIRONMENT=development

# --- Database (adjust to your chosen DB) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=admin
DB_PASSWORD=changeme

# --- Service Ports ---
SERVICE_A_PORT=5000
SERVICE_B_PORT=5002
GATEWAY_PORT=8080
FRONTEND_PORT=3000
PLAYER_SERVICE_PORT=5001
QUEUE_SERVICE_PORT=5003
MATCH_SERVICE_PORT=5002
RATING_SERVICE_PORT=5005
MATCHMAKING_PROCESS_SERVICE_PORT=5004
GLICKO2_SERVICE_PORT=5006

# --- API Gateway ---
GATEWAY_SECRET=your-gateway-secret

# --- Player Service Database ---
PLAYER_DB_HOST=player-db
PLAYER_DB_PORT=5432
PLAYER_DB_INTERNAL_PORT=3306
PLAYER_DB_NAME=playerdb
PLAYER_DB_USER=player
PLAYER_DB_PASSWORD=playerpass
PLAYER_DB_ROOT_PASSWORD=rootpass

# --- Queue Service Database ---
QUEUE_DB_HOST=queue-db
QUEUE_DB_PORT=5434
QUEUE_DB_INTERNAL_PORT=3306
QUEUE_DB_NAME=queuedb
QUEUE_DB_USER=queue
QUEUE_DB_PASSWORD=queuepass
QUEUE_DB_ROOT_PASSWORD=rootpass

# --- Service Base URLs ---
PLAYER_SERVICE_BASE_URL=http://player-service:5001
QUEUE_SERVICE_BASE_URL=http://queue-service:5003
RATING_SERVICE_BASE_URL=http://rating-service:5005
MATCHMAKING_PROCESS_SERVICE_BASE_URL=http://matchmaking-process-service:5004
GLICKO2_SERVICE_BASE_URL=http://glicko2-rating-service:5006

# --- Match Service Database ---
MATCH_DB_HOST=match-db
MATCH_DB_PORT=5433
MATCH_DB_INTERNAL_PORT=3306
MATCH_DB_NAME=matchdb
MATCH_DB_USER=match
MATCH_DB_PASSWORD=matchpass
MATCH_DB_ROOT_PASSWORD=rootpass

# --- Rating Service Database ---
RATING_DB_HOST=rating-db
RATING_DB_PORT=5435
RATING_DB_INTERNAL_PORT=3306
RATING_DB_NAME=ratingdb
RATING_DB_USER=rating
RATING_DB_PASSWORD=ratingpass
RATING_DB_ROOT_PASSWORD=rootpass

# --- Add more variables as needed for your stack ---
# REDIS_URL=redis://localhost:6379
# RABBITMQ_URL=amqp://localhost:5672
# JWT_SECRET=your-jwt-secret
